APP_NAME=Sistem Akademik SMK Nurul Ulum
APP_ENV=production
APP_KEY=
# WAJIB false di produksi — jangan pernah menampilkan detail error ke publik.
APP_DEBUG=false
APP_URL=https://your-domain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smknulum
DB_USERNAME=smknulum_app
DB_PASSWORD=

# Bila memakai SQLite (local development) ganti blok di atas menjadi:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Cara setup MySQL dari file database/smknulum.sql:
#   mysql -u USERNAME -p < database/smknulum.sql
# File tersebut membuat database `smknulum`, 40 tabel lengkap, dan data awal.

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Aktifkan di produksi (HTTPS) agar cookie sesi tidak pernah dikirim lewat HTTP.
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Jangan ubah kecuali diperlukan; digunakan sebagai nama cookie sesi.
SESSION_COOKIE=smknulum_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=Asia/Jakarta

# --- CATATAN KEAMANAN DEPLOYMENT ---
# 1. Jalankan `php artisan key:generate` dan simpan APP_KEY dengan aman.
# 2. Pastikan APP_DEBUG=false dan APP_ENV=production di server.
# 3. Wajib HTTPS (SSL) — aplikasi mengirim header HSTS di produksi.
# 4. SESSION_SECURE_COOKIE=true wajib saat HTTPS aktif.
# 5. Ganti semua password default dari seeder (jangan pakai 'password').
# 6. Back up database secara rutin dan batasi akses file .env (chmod 600).
